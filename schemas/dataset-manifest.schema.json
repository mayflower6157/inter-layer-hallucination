{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dissertation/dataset-manifest.schema.json",
  "title": "Dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "display_name", "modality", "source_url", "revision", "license", "fields", "splits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "modality": {"enum": ["text", "vision_language"]},
    "source_url": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "adapter": {"type": ["string", "null"], "minLength": 1},
    "notes": {"type": "string"},
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "reference_answer": {"type": ["string", "null"]},
        "image": {"type": ["string", "null"]},
        "group_id": {"type": ["string", "null"]},
        "metadata": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "splits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "format": {"enum": ["json", "jsonl"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "count": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
